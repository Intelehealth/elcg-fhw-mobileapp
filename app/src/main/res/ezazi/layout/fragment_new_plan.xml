<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="updatePosition"
            type="Integer" />

        <variable
            name="plan"
            type="org.intelehealth.ezazi.models.dto.ObsDTO" />

    </data>

    <LinearLayout
        android:id="@+id/clAddNewMedicineInputBox"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="@dimen/screen_padding"
        android:layout_marginBottom="@dimen/screen_padding"
        android:background="@drawable/container_bg_rounded"
        android:orientation="vertical"
        android:padding="@dimen/screen_container_padding">

        <!-- LCG RISKS PANEL -->

        <androidx.cardview.widget.CardView
            android:id="@+id/cardLcgRisks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/screen_padding"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="@dimen/std_8dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Header -->

                <LinearLayout
                    android:id="@+id/llLcgRisksHeader"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/screen_container_padding">

                    <ImageView
                        android:id="@+id/ivLcgRisksIcon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="8dp"
                        android:src="@drawable/baseline_warning_amber_24" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/lbl_lcg_risks"
                        android:textColor="@color/colorInputText"
                        android:textSize="@dimen/button_text_size"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/ivLcgRisksChevron"
                        android:layout_width="@dimen/ib_edit_details_size"
                        android:layout_height="@dimen/ib_edit_details_size"
                        android:src="@drawable/ic_dropdown" />

                </LinearLayout>

                <!-- Body -->

                <LinearLayout
                    android:id="@+id/llLcgRisksBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="@dimen/screen_container_padding"
                    android:paddingHorizontal="@dimen/screen_container_padding"
                    android:visibility="visible">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvLcgAlerts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="true"
                        android:scrollbars="vertical"
                        android:fadeScrollbars="false"
                        android:scrollbarStyle="insideInset"/>

                    <TextView
                        android:id="@+id/tvLcgNoAlerts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:paddingVertical="12dp"
                        android:text="@string/lbl_no_active_lcg_alerts"
                        android:textColor="@color/gray"
                        android:textSize="@dimen/lcg_container_text_size"
                        android:textStyle="bold"
                        android:visibility="gone" />

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- TEXT AREA -->

        <org.intelehealth.ezazi.ui.custom.RightAlignErrorTextInputLayout
            android:id="@+id/etLayoutMotherDeceased"
            style="@style/Theme.EZazi.Input.Login"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="@dimen/screen_padding"
            app:boxStrokeColor="@color/colorLoginInputStroke"
            app:boxStrokeWidth="@dimen/input_stroke_size">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNewPlan"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:backgroundTint="@color/white"
                android:gravity="top|start"
                android:hint="@string/enter_here"
                android:imeOptions="actionDone"
                android:minHeight="@dimen/plan_field_min_height"
                android:inputType="textMultiLine"
                android:lineSpacingExtra="@dimen/std_4dp"
                android:scrollbars="vertical"
                android:text="@{plan.value}"
                android:textColor="@color/colorInputText"
                android:textSize="@dimen/input_inner_size" />

        </org.intelehealth.ezazi.ui.custom.RightAlignErrorTextInputLayout>

        <!-- FOOTER -->

        <LinearLayout
            android:id="@+id/layoutButtonsAdd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddPlanCancel"
                style="@style/Theme.EZazi.Button.White"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/screen_container_padding"
                android:layout_weight="1"
                android:text="@string/cancel" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddPlanAdd"
                style="@style/Theme.EZazi.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_container_padding"
                android:layout_weight="1"
                android:text="@string/lbl_add" />

        </LinearLayout>

    </LinearLayout>

</layout>
