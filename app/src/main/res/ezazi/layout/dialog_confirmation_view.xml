<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <variable
            name="heading"
            type="String" />

        <variable
            name="content"
            type="String" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center|top"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="@dimen/screen_container_padding">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvAlertTitle"
            style="@style/Theme.EZazi.Text.Dialog.Alert.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingStart="@dimen/screen_container_padding"
            android:paddingTop="@dimen/screen_container_padding"
            android:paddingEnd="@dimen/screen_container_padding"
            android:text="@{heading}"
            android:textColor="@color/red"
            android:visibility="@{heading == null || heading.length() == 0 ? View.GONE : View.VISIBLE}"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="@string/emergency" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollIndicators="end"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvAlertTitle">

            <com.google.android.material.textview.MaterialTextView
                style="@style/Theme.EZazi.Text.Dialog.Content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@{content}"
                android:textColor="?attr/colorPrimary"
                tools:text="@string/setup_internet" />
        </ScrollView>
    </LinearLayout>
</layout>
