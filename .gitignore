*.iml
*.json
.gradle
# Any directory named "assets", at any depth, in any source set or module.
# Asset payloads are per-deployment and handed over out of band: the app is open
# source and the assets are not. The trailing slash matches directories only, so a
# file such as app/src/main/assets-1-03-2024.zip is unaffected.
assets/
salt.env
.idea/misc.xml
/local.properties
/.idea/caches
/.idea/libraries
/.idea/modules.xml
/.idea/workspace.xml
/.idea/navEditor.xml
/.idea/assetWizardSettings.xml
.DS_Store
/build
/captures
.idea/caches/build_file_checksums.ser
.externalNativeBuild
*.jpg

.idea/
/webrtc/build/
/app/release/
*.txt
